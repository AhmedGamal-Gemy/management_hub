# Supabase (cloud project)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=change-me-from-supabase-dashboard-settings-api

# Groq (free tier) — consumed by the backend via the litellm package
GROQ_API_KEY=gsk_...

# Backend address for Next.js server-side rewrites (/backend/*).
# Local docker: http://backend:8000. Replit: http://localhost:8000.
BACKEND_INTERNAL_URL=http://localhost:8000

# Provider model string for Replit library mode (proxy mode uses
# litellm-config.yaml model names instead, e.g. "tutor-ops")
LITELLM_MODEL=groq/llama-3.3-70b-versatile
