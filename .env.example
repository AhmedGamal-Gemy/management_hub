# --- Postgres (local docker `db` service; backend CRUD build-out) ---
POSTGRES_USER=tutor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tutorops
# From inside the backend container the host is `db`; on the host use localhost.
DATABASE_URL=postgresql://tutor:change-me@localhost:5432/tutorops

# --- Frontend (Vite; PORT + BASE_PATH are required by vite.config.ts) ---
PORT=5173
BASE_PATH=/
# Where Vite dev forwards same-origin /api/* (compose service name in docker).
API_PROXY_TARGET=http://backend:8000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PROXY_URL=

# --- Backend ---
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
GROQ_API_KEY=gsk_...
LITELLM_MODEL=groq/llama-3.3-70b-versatile
# Production SPA directory served by FastAPI (Replit deploy sets this).
FRONTEND_DIST=../frontend/dist/public
